{
  "expo": {
    "name": "H2S Dosimeter Reader",
    "slug": "sih26118-h2s-reader",
    "scheme": "h2sreader",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow the app to access your camera to read the dosimeter strip."
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sih26118.h2sreader"
    },
    "android": {
      "package": "com.sih26118.h2sreader",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#1f2937"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
